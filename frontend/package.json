{
  "name": "smartinvoice-face-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build",
    "build:demo-bundle": "node scripts/build-demo-bundle.mjs",
    "build:demo": "node scripts/build-demo-bundle.mjs && node scripts/copy-ocr-assets.mjs && tsc -b && vite build --mode demo",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "copy:ocr": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/spa": "1.0.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
