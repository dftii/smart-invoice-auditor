# URL base de la API que usa el navegador. Vacía = mismo origen, bajo la ruta base de la aplicación
# (VITE_BASE_PATH): /api/v1 con base "/" o /<ruta-base>/api/v1 con una subruta. Debe servirla el proxy de Vite o nginx.
VITE_API_BASE_URL=
# Subruta de publicación de la aplicación (por ejemplo /smart-invoice-auditor/ en GitHub Pages). Por defecto "/".
VITE_BASE_PATH=
# Clave de API opcional: se envía como cabecera X-API-Key. Va incluida en el JavaScript público; no uses secretos reales.
VITE_API_KEY=
# Destino del proxy de desarrollo de Vite (npm run dev / npm run preview).
VITE_API_PROXY_TARGET=http://localhost:8000
