# SmartInvoice-FACe Auditor - variables de Docker Compose (raíz del repositorio).
# Copia este fichero a .env en la raíz para cambiar los valores por defecto.
# Compose las usa para sustituir ${VARIABLE} en docker-compose.yml. Las variables del
# servicio mysql se pasan a ese contenedor; el resto no llega al backend.
# La configuración de la aplicación va en backend/.env (ver backend/.env.example).

# URL de base de datos del backend en Docker. Sin definir o vacía = SQLite en el volumen backend-data.
# Para MySQL usa el host "mysql" (nombre del servicio), no "localhost".
# DATABASE_URL=mysql+pymysql://smartinvoice:smartinvoice@mysql:3306/smartinvoice?charset=utf8mb4

# --- Servicio mysql (perfil "mysql") ---
# Contraseña del usuario root de MySQL.
MYSQL_ROOT_PASSWORD=smartinvoice-root
# Base de datos creada al inicializar el contenedor.
MYSQL_DATABASE=smartinvoice
# Usuario de la aplicación. Si cambias el usuario o la contraseña, actualiza también DATABASE_URL.
MYSQL_USER=smartinvoice
# Contraseña del usuario de la aplicación.
MYSQL_PASSWORD=smartinvoice
