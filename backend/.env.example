# SmartInvoice-FACe Auditor - variables de entorno del backend.
# Copia este fichero a backend/.env y ajusta los valores que necesites.
# Las variables no definidas usan el valor por defecto indicado en cada comentario.
# Las listas se escriben en sintaxis JSON.

# --- Aplicación ---
# Nombre mostrado en la documentación de la API.
APP_NAME="SmartInvoice-FACe Auditor"
# Versión expuesta en la documentación de la API.
APP_VERSION=1.0.0
# Prefijo común de todos los endpoints de la API.
API_PREFIX=/api/v1
# Orígenes permitidos por CORS (por ejemplo, el frontend de Vite en desarrollo).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Nivel de logging: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Seguridad de la API ---
# Clave compartida opcional. Si se define, todas las rutas /api/v1/** exigen la cabecera
# "X-API-Key: <clave>" (401 si falta o no coincide). /health siempre es público.
# La firma XAdES de facturas SOLO está disponible cuando API_KEY está definida: sin ella,
# ?sign=true responde 403 y la exportación por defecto sale sin firmar aunque haya certificado
# (al arrancar se registra un aviso WARNING si hay certificado pero no API_KEY).
API_KEY=

# --- Base de datos ---
# Por defecto: SQLite en backend/data/smartinvoice.db (ruta calculada automáticamente).
# DATABASE_URL=sqlite:///C:/ruta/absoluta/backend/data/smartinvoice.db
# MySQL (ver la sección "Migración a MySQL" del README):
# DATABASE_URL=mysql+pymysql://smartinvoice:smartinvoice@localhost:3306/smartinvoice?charset=utf8mb4
# Muestra cada sentencia SQL en el log (solo para depuración).
DATABASE_ECHO=false
# Conexiones permanentes del pool (solo aplica a MySQL).
DATABASE_POOL_SIZE=5
# Conexiones adicionales permitidas por encima del pool (solo aplica a MySQL).
DATABASE_MAX_OVERFLOW=10

# --- Almacenamiento de ficheros ---
# Por defecto: backend/data/uploads. Si la defines, usa una ruta absoluta.
# UPLOAD_DIR=/ruta/absoluta/a/uploads
# Tamaño máximo de cada factura subida, en megabytes.
MAX_UPLOAD_SIZE_MB=15
# Tipos MIME admitidos para la subida de facturas.
ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg","image/webp"]

# --- Extracción con IA ---
# Clave de la API de Anthropic. Vacía = Modo Demo (sin llamadas externas).
ANTHROPIC_API_KEY=
# Modelo de Claude usado para extraer los datos de la factura.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tiempo máximo de espera de la llamada a la API, en segundos (sin reintentos automáticos;
# el proxy inverso debe permitir más tiempo que este valor, p. ej. 180 s en nginx).
AI_TIMEOUT_SECONDS=90.0
# Si la extracción con IA falla, usa el Modo Demo en lugar de devolver 422. Los datos del Modo Demo
# son sintéticos (is_synthetic=true): nunca se validan ni se exportan a Facturae.
AI_FALLBACK_TO_DEMO=false

# --- Auditoría fiscal ---
# Tolerancia para comparar importes, en euros (la comparación es exacta al céntimo).
AUDIT_TOLERANCE=0.01
# Tipos de IVA admitidos (en porcentaje).
ALLOWED_VAT_RATES=[21,10,4,0]
# Tipos de retención IRPF admitidos (en porcentaje).
ALLOWED_IRPF_RATES=[0,1,2,7,15,19]

# --- Facturae / FACe ---
# Ruta al certificado PKCS#12 (.p12 / .pfx) para firmar el XML con XAdES. Vacía = sin firma.
FACTURAE_CERT_PATH=
# La firma requiere además API_KEY (ver "Seguridad de la API").
# Contraseña del certificado PKCS#12. Vacía = sin contraseña.
FACTURAE_CERT_PASSWORD=

# --- Docker (docker compose) ---
# Con Docker, este fichero se pasa como variables de entorno a los servicios backend y seed.
# Dentro del contenedor, la base de datos SQLite y las facturas subidas viven en /app/data,
# que corresponde al volumen "backend-data". No uses rutas de Windows (C:\...) en Docker.
# DATABASE_URL del .env de la raíz o del shell prevalece sobre la de este fichero (ver docker-compose.yml).
# Para MySQL en Docker, define DATABASE_URL en el .env de la raíz con el host "mysql".
